<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AndroidApp" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <!-- android:windowFullscreen is deliberately absent. Status bar visibility
         is decided at runtime by MainActivity: hidden for the default fullscreen
         look, shown and transparent when edge-to-edge is enabled so the page
         can read a non-zero env(safe-area-inset-top). -->
    <style name="Theme.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
